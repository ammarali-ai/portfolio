# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini (free tier) — for "Ask my CV" chatbot
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend (free tier: 3000/mo) — for contact form
# Get a free key at: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=muhammadammaralibhutta@gmail.com

# Admin panel
# Generate a bcrypt hash of your password (any online bcrypt generator works)
ADMIN_PASSWORD_HASH=
# Random 32+ character string for JWT signing
ADMIN_SESSION_SECRET=

# GitHub API — for admin panel to commit markdown changes
# Create a fine-grained PAT with "Contents: Read & write" on this repo
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_OWNER=ammarali-ai
GITHUB_REPO=portfolio
GITHUB_BRANCH=main
