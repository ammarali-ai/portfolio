# Copy to .env.local and fill in. Never commit real keys.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- "Ask Ammar" assistant + CV ranker (server-only) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to the Haiku alias in lib/anthropic.ts
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Contact form (Resend) ---
RESEND_API_KEY=
# Must be a domain verified in Resend; onboarding@resend.dev works for testing
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=muhammadammaralibhutta@gmail.com

# --- Rate limiting (optional; falls back to in-memory per-IP limits) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Automation webhook (optional): forward contact messages to n8n or Zapier ---
# n8n: URL of the Webhook node in automations/n8n/portfolio-contact-alert.json
# Zapier: "Webhooks by Zapier" → "Catch Hook" URL
AUTOMATION_WEBHOOK_URL=
# Shared secret sent as the X-Webhook-Secret header (the n8n workflow checks it)
AUTOMATION_WEBHOOK_SECRET=
